# Container deployment only. Preserve MASTER_KEY when importing an existing database.
# Use URL-safe random characters for POSTGRES_PASSWORD (no @, /, :, %, # or spaces).
POSTGRES_PASSWORD=replace-with-a-long-random-password
# New installations use StarBridge names. Existing deployments must point to
# their existing database/user/volume before switching Compose project names.
POSTGRES_DB=starbridge
POSTGRES_USER=starbridge
POSTGRES_VOLUME_NAME=starbridge_postgres_data
# Dedicated network; choose a subnet that does not overlap host or Docker routes.
STARBRIDGE_SUBNET=10.87.60.0/24
MASTER_KEY=replace-with-base64-of-32-random-bytes
BOOTSTRAP_EMAIL=admin
BOOTSTRAP_PASSWORD=replace-before-first-start
COOKIE_SECURE=false
# Explicit reverse proxy IPs/CIDRs; never trust every Internet client.
TRUSTED_PROXIES=127.0.0.1,::1
# HTTPS public origin when a reverse proxy terminates TLS, e.g. https://pay.example.com
PUBLIC_ORIGIN=
APP_VERSION=latest
# Required only with compose.registration.yml; generate once and preserve.
REGISTRATION_GATEWAY_SECRET=
